# ── Asher Hotel and Suites · API server settings ──
# Copy this file to ".env" in the same folder and fill in the values.
# Never commit .env or share it. Generate secrets with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"

# Your PostgreSQL connection (user, password, host, port, database name)
DATABASE_URL="postgresql://asher:CHANGE_ME@localhost:5432/asher_hms"

# Where the website is opened in the browser (used in emails and payment redirects)
APP_URL="http://localhost:5173"
# Browser origins allowed to call the API (comma-separated)
CLIENT_ORIGIN="http://localhost:5173"
PORT=4000

# Production on one server: build the client, then set this to true so the API also serves the website
SERVE_CLIENT=false

# 32-byte key, base64 (protects guest ID numbers). Keep a safe copy — data cannot be read without it.
DATA_ENCRYPTION_KEY="REPLACE_ME"
# One-time token to create the owner account at /manage/setup
SETUP_TOKEN="REPLACE_ME"
# Secret for /api/cron (background jobs)
CRON_SECRET="REPLACE_ME"

# Optional integrations (leave blank until available)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Asher Hotel and Suites <no-reply@asherhotel.ng>"
TERMII_API_KEY=""
TERMII_SENDER_ID="AsherHotel"
PAYSTACK_SECRET_KEY=""

# Optional, for hosting
# API_URL="https://api.asherhotel.ng"   # only if the API is on a different address from APP_URL
# TRUST_PROXY="1"                       # behind cPanel/Render/Nginx proxies
# COOKIE_DOMAIN=""
# STORAGE_DIR=""                        # where uploads are kept (default: server/storage)
